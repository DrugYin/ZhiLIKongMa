/* 教师首页 - 页面特有样式 */

.content {
  padding: 0rpx 24rpx calc(100rpx + env(safe-area-inset-bottom));
}

.navbar-wrapper {
  background: rgba(255, 255, 255, 0.96);
}

.hero-notice {
  display: block;
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  color: #8a6400;
  font-size: 22rpx;
  line-height: 1.6;
  background: rgba(248, 182, 54, 0.16);
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 18rpx 0;
  margin-top: 24rpx;
}

.quick-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
}

.quick-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(31, 122, 224, 0.12);
  color: #1f7ae0;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.quick-title {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.quick-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 18rpx 0;
  margin-top: 24rpx;
}

.stats-item {
  width: calc(33.333% - 12rpx);
  box-sizing: border-box;
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  text-align: center;
}

.stats-label {
  display: block;
  color: #7b8798;
  font-size: 22rpx;
}

.stats-value {
  display: block;
  margin-top: 10rpx;
  color: #1f3349;
  font-size: 30rpx;
  font-weight: 700;
}

.activity-list {
  margin-top: 18rpx;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(223, 229, 237, 0.9);
}

.activity-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.activity-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1f7ae0;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.activity-copy {
  flex: 1;
  min-width: 0;
}

.activity-text {
  display: block;
  color: #17314a;
  font-size: 28rpx;
  font-weight: 700;
}

.activity-time {
  display: block;
  margin-top: 8rpx;
  color: #65788c;
  font-size: 24rpx;
  line-height: 1.8;
}

.empty-activity {
  display: block;
  margin-top: 18rpx;
  color: #7b8798;
  font-size: 24rpx;
  line-height: 1.8;
}

.subscribe-guide-mask {
  position: fixed;
  inset: 0;
  z-index: 12000;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 48rpx;
  background: rgba(17, 37, 61, 0.5);
}

.subscribe-guide-card {
  width: 100%;
  box-sizing: border-box;
  padding: 44rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 72rpx rgba(23, 49, 74, 0.2);
  text-align: center;
}

.subscribe-guide-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 28rpx;
  background: rgba(31, 122, 224, 0.12);
  color: #1f7ae0;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.subscribe-guide-title {
  display: block;
  margin-top: 26rpx;
  color: #17314a;
  font-size: 34rpx;
  font-weight: 800;
}

.subscribe-guide-desc {
  display: block;
  margin-top: 18rpx;
  color: #65788c;
  font-size: 26rpx;
  line-height: 1.75;
  text-align: left;
}

.subscribe-guide-primary,
.subscribe-guide-secondary {
  margin-top: 28rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.subscribe-guide-primary {
  color: #ffffff;
  background: #1f7ae0;
}

.subscribe-guide-secondary {
  margin-top: 14rpx;
  color: #65788c;
  background: #f2f5f8;
}

.subscribe-guide-primary::after,
.subscribe-guide-secondary::after {
  border: none;
}
